# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=cocagreen
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password
COCAGREEN_ADMIN_PASSWORD=replace-with-a-long-unique-password
COCAGREEN_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Classificador
CLASSIFICADOR_URL=http://127.0.0.1:8000
CLASSIFICADOR_API_KEY=replace-with-your-api-key

# Opcional: caminho para o executável Python.
# Se não informado, o projeto tenta usar .venv e depois "python" do PATH.
# PYTHON_PATH=C:\caminho\para\python.exe
